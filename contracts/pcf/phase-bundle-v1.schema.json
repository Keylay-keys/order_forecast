{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://routespark.local/contracts/pcf/phase-bundle-v1.schema.json",
  "title": "RouteSpark PCF and Firestore redesign phase bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleState",
    "operatorRunId",
    "phase",
    "scope",
    "createdAt",
    "artifactConfig",
    "effectFlags",
    "fixtures",
    "watermarks",
    "operations",
    "parity",
    "rollback",
    "evidence",
    "signoff"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleState": { "enum": ["draft", "final"] },
    "operatorRunId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "phase": { "enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "routes", "checkpoint"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^(global|[0-9]{1,10}|wider)$"
        },
        "routes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{1,10}$" },
          "uniqueItems": true
        },
        "checkpoint": {
          "enum": ["global", "sandbox", "production_canary", "wider"]
        },
        "reviewTenantObservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "mode"],
          "properties": {
            "route": { "const": "900000" },
            "mode": { "const": "observe_only" },
            "evidence": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "artifactConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "runtimeControls", "secretKeyNames", "nonSecretConfig"],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "kind", "identity"],
            "properties": {
              "component": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["source", "deployed_artifact", "configuration", "schema"] },
              "identity": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "observedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "runtimeControls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configurationRevision",
            "pcfFirestoreDiscoveryMode",
            "pcfClusterStage",
            "pcfFirebaseWriteAuthority"
          ],
          "properties": {
            "configurationRevision": { "type": "string", "minLength": 1 },
            "pcfFirestoreDiscoveryMode": { "enum": ["legacy", "bounded", "disabled"] },
            "pcfClusterStage": { "enum": ["off", "ingress", "shadow", "claims", "projection"] },
            "pcfFirebaseWriteAuthority": { "enum": ["legacy_mac", "cluster"] }
          }
        },
        "secretKeyNames": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
          "uniqueItems": true
        },
        "nonSecretConfig": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "key", "value"],
            "properties": {
              "component": { "type": "string", "minLength": 1 },
              "key": { "type": "string", "minLength": 1 },
              "value": { "type": ["string", "number", "boolean", "null"] }
            }
          }
        }
      }
    },
    "effectFlags": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["string", "boolean", "number", "null"] }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route", "identity", "generation", "automationExcluded"],
        "properties": {
          "route": { "type": "string", "pattern": "^[0-9]{1,10}$" },
          "identity": { "type": "string", "minLength": 1 },
          "generation": { "type": ["string", "integer"], "minLength": 1 },
          "automationExcluded": { "const": true },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "watermarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sourceValue", "projectionValue", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sourceValue": { "type": ["string", "number", "null"] },
          "projectionValue": { "type": ["string", "number", "null"] },
          "status": { "enum": ["pending", "matched", "mismatch", "not_applicable"] }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "reconciliation"],
      "properties": {
        "estimate": { "$ref": "#/definitions/operationCounts" },
        "observed": { "$ref": "#/definitions/operationCounts" },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "operatorRunId"],
          "properties": {
            "status": { "enum": ["pending", "pass", "fail"] },
            "operatorRunId": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "parity": { "$ref": "#/definitions/gateResult" },
    "rollback": { "$ref": "#/definitions/gateResult" },
    "priorBundleRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "target", "operatorRunId", "decision", "manifestSha256"],
        "properties": {
          "phase": { "enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7"] },
          "target": { "type": "string", "pattern": "^(global|[0-9]{1,10}|wider)$" },
          "operatorRunId": { "type": "string", "minLength": 1 },
          "decision": { "const": "GO" },
          "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "volume", "offboxReceipt", "files"],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^/Volumes/Extreme SSD/routespark_offload/pcf-migration/firestore-read-redesign/"
        },
        "volume": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedIdentity", "observedIdentity", "freeBytes", "writeReadbackSha256"],
          "properties": {
            "expectedIdentity": { "type": "string", "minLength": 1 },
            "observedIdentity": { "type": "string", "minLength": 1 },
            "freeBytes": { "type": "integer", "minimum": 0 },
            "writeReadbackSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "offboxReceipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["pending", "pass", "fail", "not_applicable"] },
            "receiptId": { "type": "string", "minLength": 1 },
            "verifiedAt": { "type": "string", "format": "date-time" }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "roles"],
      "properties": {
        "decision": { "enum": ["DRAFT", "GO", "NO_GO"] },
        "signedAt": { "type": "string", "format": "date-time" },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "implementer": { "type": "string", "minLength": 1 },
            "releaseOperator": { "type": "string", "minLength": 1 },
            "productOwner": { "type": "string", "minLength": 1 },
            "releaseOwner": { "type": "string", "minLength": 1 }
          }
        },
        "notes": { "type": "string" }
      }
    }
  },
  "definitions": {
    "operationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firestoreReads",
        "firestoreWrites",
        "firestoreDeletes",
        "functionInvocations",
        "storageOperations",
        "postgresWrites"
      ],
      "properties": {
        "firestoreReads": { "type": "integer", "minimum": 0 },
        "firestoreWrites": { "type": "integer", "minimum": 0 },
        "firestoreDeletes": { "type": "integer", "minimum": 0 },
        "functionInvocations": { "type": "integer", "minimum": 0 },
        "storageOperations": { "type": "integer", "minimum": 0 },
        "postgresWrites": { "type": "integer", "minimum": 0 }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["pending", "pass", "fail", "not_applicable"] },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      }
    }
  }
}
