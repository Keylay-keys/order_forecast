{
  "contractVersion": "pcf-projection-evidence-v1",
  "decisions": {
    "D3": "dedicated_cluster_effect_worker_and_identities",
    "D4": "external_drive_evidence_authority"
  },
  "projectionBoundary": {
    "namespace": "routespark-edge",
    "deployment": "pcf-effects",
    "firebaseIdentity": "routespark-pcf-projection-fb@routespark-1f47d.iam.gserviceaccount.com",
    "projectRoles": ["roles/datastore.user"],
    "firestorePathScopeClaimed": false,
    "applicationWriteAllowlist": [
      "pcf_processing_queue/{route}/queue/{delivery}",
      "routes/{route}/pcfs/{delivery}",
      "routes/{route}/pcfs/{delivery}/containers/{container}",
      "routeDashboardSummaries/{route}",
      "routeDashboardSummaries/{route}/containers/{container}",
      "admin_alerts/{deterministicAlertId}"
    ],
    "forbidden": [
      "Firebase Auth administration",
      "unscoped Firestore discovery",
      "Cloud Storage create/update",
      "direct Mac Firebase writes",
      "effect execution unless PCF_FIREBASE_WRITE_AUTHORITY=cluster",
      "effect execution unless PCF_CLUSTER_STAGE=projection"
    ]
  },
  "verificationBoundary": {
    "identity": "routespark-pcf-verifier@routespark-1f47d.iam.gserviceaccount.com",
    "projectRoles": ["roles/datastore.viewer", "roles/storage.objectViewer"],
    "firestore": "read-only exact-path verification",
    "storage": "read-only exact-object verification",
    "writeOrDelete": false,
    "mustDifferFrom": [
      "routespark-pcf-projection-fb@routespark-1f47d.iam.gserviceaccount.com",
      "routespark-pcf-object-projector@routespark-1f47d.iam.gserviceaccount.com",
      "routespark-pcf-object-cleaner@routespark-1f47d.iam.gserviceaccount.com"
    ]
  },
  "storageBoundaries": {
    "canonicalProjector": {
      "identity": "routespark-pcf-object-projector@routespark-1f47d.iam.gserviceaccount.com",
      "customRole": "projects/routespark-1f47d/roles/routesparkPcfObjectProjector",
      "permissions": ["storage.objects.get", "storage.objects.create", "storage.objects.update"],
      "bucketCondition": "resource.name.startsWith('projects/_/buckets/routespark-1f47d.firebasestorage.app/objects/routes/')",
      "callerBinding": "roles/iam.serviceAccountTokenCreator granted only to routespark-pcf-projection-fb on this service account",
      "sourceGenerationPreconditionRequired": true,
      "destinationGenerationPreconditionRequired": true,
      "prefixOrBulkWriteForbidden": true
    },
    "claimUrlSigner": {
      "identity": "routespark-pcf-object-signer@routespark-1f47d.iam.gserviceaccount.com",
      "customRole": "projects/routespark-1f47d/roles/routesparkPcfObjectReader",
      "permissions": ["storage.objects.get"],
      "bucketCondition": "resource.name.startsWith('projects/_/buckets/routespark-1f47d.firebasestorage.app/objects/routes/')",
      "callerBinding": "roles/iam.serviceAccountTokenCreator granted only to routespark-pcf-projection-fb on this service account",
      "allowedMethod": "GET",
      "generationRequired": true,
      "privateKeyFile": false
    },
    "exactCleaner": {
      "identity": "routespark-pcf-object-cleaner@routespark-1f47d.iam.gserviceaccount.com",
      "customRole": "projects/routespark-1f47d/roles/routesparkPcfObjectCleaner",
      "permissions": ["storage.objects.get", "storage.objects.delete"],
      "bucketCondition": "resource.name.startsWith('projects/_/buckets/routespark-1f47d.firebasestorage.app/objects/routes/')",
      "callerBinding": "roles/iam.serviceAccountTokenCreator granted only to routespark-pcf-projection-fb on this service account",
      "generationPreconditionRequired": true,
      "prefixOrBulkDeleteForbidden": true
    }
  },
  "workerBoundary": {
    "macPrincipal": "pcf-macos-vision-01",
    "firebaseCredential": false,
    "postgresCredential": false,
    "storageCredential": false,
    "input": "frozen claim plus exact generation-bound signed GET URLs",
    "output": "structured proposal and external evidence references through authenticated result API"
  },
  "evidenceAuthority": {
    "root": "/Volumes/Extreme SSD/routespark_offload/ocr-agent-review",
    "owner": "Mac OCR/review workflow",
    "clusterReadMount": {
      "root": "/mnt/archive/pcf/pcf_effect_evidence",
      "mode": "readOnly",
      "requiredFor": ["projecting", "cleaning"],
      "writableByCluster": false,
      "missingBehavior": "block_current_effect_step"
    },
    "publication": {
      "macMount": "/Volumes/RouteSparkArchive",
      "macPublishRoot": "/Volumes/RouteSparkArchive/pcf/pcf_effect_evidence",
      "networkClientInWorker": false,
      "requiredBeforeResultSubmission": true,
      "directoryIdentity": "{workId}-attempt-{attemptNumber}",
      "copyScope": "one exact work-attempt directory",
      "commit": "verified staging directory renamed atomically to an absent final directory",
      "existingFinal": "accept only after complete file/size/SHA-256 parity",
      "partialOrConflictingBehavior": "do not submit result; retain exact staging evidence for operator disposition",
      "remoteOrPrefixDelete": false
    },
    "packageIdentity": ["route", "delivery", "inputHashVersion", "inputHash"],
    "requiredBeforeProjection": [
      "exact source-object inventory with Storage generations",
      "source image bytes copied under evidence/images",
      "SHA-256 for every copied image",
      "before payload",
      "proposed result and confidence evidence",
      "manifest containing hashes of package artifacts"
    ],
    "requiredBeforeCleanup": [
      "projection write completed",
      "independent exact Firebase read-back passed",
      "evidence image hashes re-verified",
      "exact source generation still matches"
    ],
    "failureMode": "block before projection or cleanup",
    "overwriteExistingPackage": false,
    "postgresStores": ["package identity", "manifest SHA-256", "relative evidence references"],
    "postgresIsEvidenceAuthority": false,
    "clusterStorageIsEvidenceAuthority": false,
    "automaticEvidenceDeletion": false
  },
  "rollout": {
    "productionResourcesExist": false,
    "provisionOnlyAfterP1_5": true,
    "effectsDefaultEnabled": false,
    "routeOrder": ["988200", "989262", "widen"],
    "route900000": "observe_only"
  }
}
