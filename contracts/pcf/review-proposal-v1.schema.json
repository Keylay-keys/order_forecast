{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routespark.local/contracts/pcf/review-proposal-v1.schema.json",
  "title": "RouteSpark complete PCF review proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "delivery", "loadingDate", "identityVerification", "deliveryAssignments", "confidence", "confidenceTier", "confidenceReasons", "uncertainRows", "containers"],
  "properties": {
    "route": {"type": "string", "pattern": "^[0-9]{6}$"},
    "delivery": {"type": "string", "pattern": "^[0-9]{8,12}$"},
    "loadingDate": {"type": "string", "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$"},
    "identityVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryNumber", "loadingDate"],
      "properties": {
        "deliveryNumber": {"$ref": "#/$defs/deliveryIdentity"},
        "loadingDate": {"$ref": "#/$defs/dateIdentity"}
      }
    },
    "deliveryAssignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deliveryNumber", "loadingDate", "containerCodes", "status", "evidence"],
        "properties": {
          "deliveryNumber": {"type": "string", "pattern": "^[0-9]{8,12}$"},
          "loadingDate": {"type": "string", "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$"},
          "containerCodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9]{18}$"}
          },
          "status": {"$ref": "#/$defs/identityStatus"},
          "evidence": {"$ref": "#/$defs/evidenceStrings"}
        }
      }
    },
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "confidenceTier": {"type": "string", "enum": ["high", "medium", "low"]},
    "confidenceReasons": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 1024}},
    "uncertainRows": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 1024}},
    "containers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["containerCode", "pages"],
        "properties": {
          "containerCode": {"type": "string", "pattern": "^[0-9]{18}$"},
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pageNumber", "items"],
              "properties": {
                "pageNumber": {"type": "integer", "minimum": 1},
                "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identityStatus": {"type": "string", "enum": ["verified", "needs_review"]},
    "evidenceStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "deliveryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "evidence"],
      "properties": {
        "value": {"type": "string", "pattern": "^[0-9]{8,12}$"},
        "status": {"$ref": "#/$defs/identityStatus"},
        "evidence": {"$ref": "#/$defs/evidenceStrings"}
      }
    },
    "dateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "evidence"],
      "properties": {
        "value": {"type": "string", "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$"},
        "status": {"$ref": "#/$defs/identityStatus"},
        "evidence": {"$ref": "#/$defs/evidenceStrings"}
      }
    },
    "item": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "bestBefore", "days", "isShortCoded", "description"],
          "properties": {
            "product": {"$ref": "#/$defs/product"},
            "bestBefore": {"type": "string", "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$"},
            "days": {"type": "string", "pattern": "^[0-9]{1,3}\\*$"},
            "isShortCoded": {"const": true},
            "description": {"$ref": "#/$defs/description"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "bestBefore", "days", "isShortCoded", "description"],
          "properties": {
            "product": {"$ref": "#/$defs/product"},
            "bestBefore": {"type": "string", "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$"},
            "days": {"type": "string", "pattern": "^[0-9]{1,3}$"},
            "isShortCoded": {"const": false},
            "description": {"$ref": "#/$defs/description"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "bestBefore", "days", "isShortCoded", "description"],
          "properties": {
            "product": {"$ref": "#/$defs/product"},
            "bestBefore": {"const": ""},
            "days": {"const": "0"},
            "isShortCoded": {"const": false},
            "description": {"$ref": "#/$defs/description"}
          }
        }
      ]
    },
    "product": {
      "type": "string",
      "pattern": "^[0-9]{4,5}$",
      "not": {"enum": ["22770", "32346", "37433", "52094", "52191", "52271", "53078"]}
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
